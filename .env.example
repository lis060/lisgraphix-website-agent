# Copy to .env.local and fill in. Never commit real values.
# This scaffold does not read any of these yet; they are placeholders for the
# integrations that still need authorization.

# Google Places API key (business discovery). Not configured.
GOOGLE_PLACES_API_KEY=

# Supabase database connection string (Project Settings > Database). Contains
# the database password. Only needed for: npm run discover -- --save
DATABASE_URL=

# Vercel (demo preview hosting). Not configured. Paid hosting not authorized.
VERCEL_TOKEN=

# Email provider for the daily report. Not configured.
EMAIL_PROVIDER_API_KEY=
REPORT_RECIPIENT_EMAIL=

# Scheduler secret that protects the run endpoint. Generate a long random value.
CRON_SECRET=

# AI image generation (demo galleries). FREE option: Cloudflare Workers AI.
# Every Cloudflare account has a free daily allowance. Create an API token with
# the "Workers AI" permission, then fill in both lines. Generation only runs when
# a key is set, and is capped per day in settings. Never share these values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Paid alternative (OpenAI), only used when the Cloudflare lines above are empty.
IMAGE_API_KEY=
IMAGE_MODEL=

# Web search for the second website check. Set ONE of these.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
